---
const pathname = new URL(Astro.request.url).pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <span class="lantern-icon">🏮</span>
      <div class="brand-text">
        <span class="brand-name">Tim Borny</span>
        <span class="brand-tagline">Liminal Lantern</span>
      </div>
    </a>

    <nav class="nav-links">
      <a href="/#lantern" class={pathname === '/' ? 'active' : ''}>Lantern</a>
      <a href="/#workbench" class="">Workbench</a>
      <a href="/photography" class={pathname.startsWith('/photography') ? 'active' : ''}>Photography</a>
      <a href="/#about" class="">About</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    border-bottom: 1px solid var(--border);
    background: rgba(13, 15, 18, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lantern-icon {
    font-size: 1.35rem;
    filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.35));
    transition: transform 0.2s ease;
  }

  .brand:hover .lantern-icon {
    transform: scale(1.1) rotate(-3deg);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .brand-tagline {
    font-size: 0.72rem;
    color: var(--text-dim);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.88rem;
  }

  .nav-links a {
    color: var(--text-muted);
    transition: color 0.15s ease;
    padding: 0.25rem 0;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--text);
  }

  .nav-links a.active {
    border-bottom: 1.5px solid var(--lantern);
  }

  @media (max-width: 500px) {
    .nav-links {
      gap: 0.85rem;
      font-size: 0.82rem;
    }
    .brand-tagline {
      display: none;
    }
  }
</style>
