---
import { curatedPhotos } from '../data/photos';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const displayPhotos = limit ? curatedPhotos.slice(0, limit) : curatedPhotos;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="photo-gallery">
  <div class="gallery-grid">
    {displayPhotos.map((photo, index) => {
      const fullSrc = `${base}/${photo.src}`;
      return (
        <div
          class="photo-card"
          data-index={index}
          data-src={fullSrc}
        >
          <img
            src={fullSrc}
            alt=""
            loading="lazy"
            decoding="async"
            class="gallery-img"
            onload="this.classList.add('is-loaded')"
          />
        </div>
      );
    })}
  </div>

  <!-- Fullscreen Lightbox Overlay -->
  <dialog id="photo-lightbox" class="lightbox-dialog">
    <button id="close-lightbox" class="lightbox-btn close-btn" aria-label="Close dialog">✕</button>
    <button id="prev-lightbox" class="lightbox-btn nav-btn prev-btn" aria-label="Previous photo">‹</button>
    <button id="next-lightbox" class="lightbox-btn nav-btn next-btn" aria-label="Next photo">›</button>
    
    <div class="lightbox-content">
      <img id="lightbox-img" src="" alt="" />
    </div>
  </dialog>
</div>

<script>
  const dialog = document.getElementById('photo-lightbox') as HTMLDialogElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('close-lightbox');
  const prevBtn = document.getElementById('prev-lightbox');
  const nextBtn = document.getElementById('next-lightbox');

  const cards = Array.from(document.querySelectorAll('.photo-card')) as HTMLElement[];
  const photoSources = cards.map(c => c.getAttribute('data-src') || '');
  let currentIndex = 0;

  function showPhoto(index: number) {
    if (index < 0) index = photoSources.length - 1;
    if (index >= photoSources.length) index = 0;
    currentIndex = index;

    if (lightboxImg && photoSources[currentIndex]) {
      lightboxImg.style.opacity = '0';
      lightboxImg.src = photoSources[currentIndex];
      lightboxImg.onload = () => {
        lightboxImg.style.opacity = '1';
      };
    }
  }

  cards.forEach((card, index) => {
    card.addEventListener('click', () => {
      showPhoto(index);
      dialog?.showModal();
    });

    // Ensure already cached/completed images fade in
    const img = card.querySelector('img');
    if (img && img.complete) {
      img.classList.add('is-loaded');
    }
  });

  closeBtn?.addEventListener('click', () => dialog?.close());
  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showPhoto(currentIndex - 1);
  });
  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showPhoto(currentIndex + 1);
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  window.addEventListener('keydown', (e) => {
    if (!dialog?.open) return;
    if (e.key === 'ArrowLeft') showPhoto(currentIndex - 1);
    if (e.key === 'ArrowRight') showPhoto(currentIndex + 1);
    if (e.key === 'Escape') dialog.close();
  });
</script>

<style>
  .gallery-grid {
    column-count: 1;
    column-gap: 1.25rem;
  }

  @media (min-width: 540px) {
    .gallery-grid {
      column-count: 2;
    }
  }

  @media (min-width: 860px) {
    .gallery-grid {
      column-count: 3;
    }
  }

  .photo-card {
    break-inside: avoid;
    margin-bottom: 1.25rem;
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: #11141a;
    border: 1px solid var(--border);
    cursor: zoom-in;
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .photo-card:hover {
    transform: translateY(-2px);
    border-color: rgba(245, 158, 11, 0.4);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .gallery-img {
    width: 100%;
    height: auto;
    display: block;
    opacity: 0;
    transition: opacity 0.8s ease-in-out, transform 0.3s ease;
  }

  .gallery-img.is-loaded {
    opacity: 1;
  }

  .photo-card:hover .gallery-img {
    transform: scale(1.02);
  }

  /* Fullscreen Lightbox Overlay */
  .lightbox-dialog {
    margin: auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: rgba(10, 12, 15, 0.95);
    backdrop-filter: blur(20px);
    color: var(--text);
    max-width: 95vw;
    max-height: 95vh;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9);
  }

  .lightbox-dialog::backdrop {
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(6px);
  }

  .lightbox-content {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    position: relative;
  }

  .lightbox-content img {
    max-width: 88vw;
    max-height: 85vh;
    object-fit: contain;
    border-radius: var(--radius);
    transition: opacity 0.2s ease-in-out;
  }

  .lightbox-btn {
    position: absolute;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease, transform 0.15s ease, color 0.15s ease;
    z-index: 10;
  }

  .lightbox-btn:hover {
    background: rgba(245, 158, 11, 0.25);
    border-color: var(--lantern);
    color: var(--lantern);
    transform: scale(1.08);
  }

  .close-btn {
    top: 1rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    font-size: 1rem;
  }

  .nav-btn {
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    font-size: 1.6rem;
    line-height: 1;
  }

  .nav-btn:hover {
    transform: translateY(-50%) scale(1.08);
  }

  .prev-btn {
    left: 1rem;
  }

  .next-btn {
    right: 1rem;
  }

  @media (max-width: 600px) {
    .nav-btn {
      width: 36px;
      height: 36px;
      font-size: 1.2rem;
    }
    .lightbox-content {
      padding: 1rem;
    }
  }
</style>
