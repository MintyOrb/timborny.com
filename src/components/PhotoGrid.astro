---
import { curatedPhotos } from '../data/photos';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const displayPhotos = limit ? curatedPhotos.slice(0, limit) : curatedPhotos;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="photo-gallery">
  <div class="gallery-grid">
    {displayPhotos.map((photo, index) => {
      const fullSrc = `${base}/${photo.src}`;
      return (
        <div
          class="photo-card"
          data-index={index}
          data-src={fullSrc}
          style={`aspect-ratio: ${photo.width} / ${photo.height};`}
        >
          <img
            src={fullSrc}
            alt=""
            width={photo.width}
            height={photo.height}
            loading="lazy"
            decoding="async"
            class="gallery-img"
            onload="this.classList.add('is-loaded')"
          />
        </div>
      );
    })}
  </div>

  <!-- Fullscreen Lightbox Overlay -->
  <dialog id="photo-lightbox" class="lightbox-dialog">
    <button id="close-lightbox" class="lightbox-btn close-btn" aria-label="Close dialog">✕</button>
    <button id="prev-lightbox" class="lightbox-btn nav-btn prev-btn" aria-label="Previous photo">‹</button>
    <button id="next-lightbox" class="lightbox-btn nav-btn next-btn" aria-label="Next photo">›</button>
    
    <div class="lightbox-content">
      <img id="lightbox-img" src="" alt="" />
    </div>
  </dialog>
</div>

<script>
  const dialog = document.getElementById('photo-lightbox') as HTMLDialogElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('close-lightbox');
  const prevBtn = document.getElementById('prev-lightbox');
  const nextBtn = document.getElementById('next-lightbox');

  const cards = Array.from(document.querySelectorAll('.photo-card')) as HTMLElement[];
  const photoSources = cards.map(c => c.getAttribute('data-src') || '');
  let currentIndex = 0;
  let isClosing = false;

  function showPhoto(index: number) {
    if (index < 0) index = photoSources.length - 1;
    if (index >= photoSources.length) index = 0;
    currentIndex = index;

    if (lightboxImg && photoSources[currentIndex]) {
      lightboxImg.classList.remove('active');
      const nextImg = new Image();
      nextImg.src = photoSources[currentIndex];
      nextImg.onload = () => {
        lightboxImg.src = photoSources[currentIndex];
        requestAnimationFrame(() => {
          lightboxImg.classList.add('active');
        });
      };
    }
  }

  function openModal(index: number) {
    isClosing = false;
    dialog.classList.remove('is-closing');
    showPhoto(index);
    dialog.showModal();
  }

  function closeModal() {
    if (isClosing || !dialog.open) return;
    isClosing = true;
    dialog.classList.add('is-closing');
    setTimeout(() => {
      dialog.close();
      dialog.classList.remove('is-closing');
      isClosing = false;
    }, 500);
  }

  cards.forEach((card, index) => {
    card.addEventListener('click', () => {
      openModal(index);
    });

    const img = card.querySelector('img');
    if (img && img.complete) {
      img.classList.add('is-loaded');
    }
  });

  closeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeModal();
  });

  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showPhoto(currentIndex - 1);
  });

  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showPhoto(currentIndex + 1);
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) {
      closeModal();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (!dialog?.open) return;
    if (e.key === 'ArrowLeft') showPhoto(currentIndex - 1);
    if (e.key === 'ArrowRight') showPhoto(currentIndex + 1);
    if (e.key === 'Escape') {
      e.preventDefault();
      closeModal();
    }
  });
</script>

<style>
  .gallery-grid {
    column-count: 1;
    column-gap: 1.25rem;
  }

  @media (min-width: 540px) {
    .gallery-grid {
      column-count: 2;
    }
  }

  @media (min-width: 860px) {
    .gallery-grid {
      column-count: 3;
    }
  }

  .photo-card {
    break-inside: avoid;
    margin-bottom: 1.25rem;
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: #14171d;
    border: 1px solid var(--border);
    cursor: zoom-in;
    display: block;
    width: 100%;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .photo-card:hover {
    transform: translateY(-2px);
    border-color: rgba(245, 158, 11, 0.4);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 0.7s ease-in-out, transform 0.3s ease;
  }

  .gallery-img.is-loaded {
    opacity: 1;
  }

  .photo-card:hover .gallery-img {
    transform: scale(1.02);
  }

  /* Fullscreen Lightbox Overlay & Smooth Animations */
  .lightbox-dialog {
    margin: auto;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    background: rgba(10, 12, 16, 0.96);
    color: var(--text);
    max-width: 95vw;
    max-height: 95vh;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.95);
    overflow: hidden;

    /* Base closed state */
    opacity: 0;
    transform: scale(0.92);
    transition:
      opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      display 0.55s allow-discrete,
      overlay 0.55s allow-discrete;
  }

  .lightbox-dialog[open] {
    opacity: 1;
    transform: scale(1);

    @starting-style {
      opacity: 0;
      transform: scale(0.92);
    }
  }

  .lightbox-dialog.is-closing {
    opacity: 0 !important;
    transform: scale(0.92) !important;
  }

  .lightbox-dialog::backdrop {
    background-color: rgba(0, 0, 0, 0);
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    transition:
      display 0.55s allow-discrete,
      overlay 0.55s allow-discrete,
      background-color 0.55s ease,
      backdrop-filter 0.55s ease;
  }

  .lightbox-dialog[open]::backdrop {
    background-color: rgba(6, 8, 11, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);

    @starting-style {
      background-color: rgba(0, 0, 0, 0);
      backdrop-filter: blur(0px);
      -webkit-backdrop-filter: blur(0px);
    }
  }

  .lightbox-dialog.is-closing::backdrop {
    background-color: rgba(0, 0, 0, 0) !important;
    backdrop-filter: blur(0px) !important;
    -webkit-backdrop-filter: blur(0px) !important;
  }

  .lightbox-content {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    position: relative;
    min-width: 320px;
    min-height: 240px;
  }

  .lightbox-content img {
    max-width: 88vw;
    max-height: 85vh;
    object-fit: contain;
    border-radius: var(--radius);
    opacity: 0;
    transform: scale(0.97);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }

  .lightbox-content img.active {
    opacity: 1;
    transform: scale(1);
  }

  .lightbox-btn {
    position: absolute;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.18s ease, transform 0.18s ease, color 0.18s ease, border-color 0.18s ease;
    z-index: 10;
  }

  .lightbox-btn:hover {
    background: rgba(245, 158, 11, 0.2);
    border-color: var(--lantern);
    color: var(--lantern);
    transform: scale(1.08);
  }

  .close-btn {
    top: 1rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    font-size: 1rem;
  }

  .nav-btn {
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    font-size: 1.6rem;
    line-height: 1;
  }

  .nav-btn:hover {
    transform: translateY(-50%) scale(1.08);
  }

  .prev-btn {
    left: 1rem;
  }

  .next-btn {
    right: 1rem;
  }

  @media (max-width: 600px) {
    .nav-btn {
      width: 36px;
      height: 36px;
      font-size: 1.2rem;
    }
    .lightbox-content {
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox-dialog,
    .lightbox-content img {
      transition: opacity 0.1s ease !important;
      transform: none !important;
    }
  }
</style>
