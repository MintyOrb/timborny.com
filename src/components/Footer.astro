---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
  <div class="footer-inner">
    <img src={`${base}/tb.png`} alt="" class="footer-monogram" />

    <div class="footer-text">
      <p>Building software, exploring interfaces, and spending time outside.</p>
    </div>

    <div class="footer-links">
      <a href="https://bsky.app/profile/timborny.bsky.social" target="_blank" rel="noopener noreferrer">Bluesky</a>
      <a href="https://linkedin.com/in/timborny" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://github.com/MintyOrb" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={`${base}/rss.xml`}>RSS</a>
      <a href="mailto:hello@timborny.com">Email</a>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Tim Borny</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 3rem 1.5rem 3.5rem;
    margin-top: auto;
  }

  .footer-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .footer-monogram {
    width: 24px;
    height: 24px;
    opacity: 0.6;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .footer-monogram:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  .footer-text {
    font-size: 0.92rem;
    color: var(--text-muted);
    max-width: 480px;
    line-height: 1.5;
    margin: 0;
  }

  .footer-text p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
    font-size: 0.88rem;
  }

  .footer-links a {
    color: var(--text-muted);
  }

  .footer-links a:hover {
    color: var(--lantern);
  }

  .footer-bottom {
    font-size: 0.78rem;
    color: var(--text-dim);
    margin-top: 0.5rem;
  }
</style>
