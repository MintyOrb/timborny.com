---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PhotoGrid from '../components/PhotoGrid.astro';

const essays = await getCollection('essays');
const sortedEssays = essays.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Tim Borny"
  description="Software, interfaces, and visual tools to help make sense of complex ideas."
>
  <!-- Hero Section -->
  <section class="hero">
    <h1 class="hero-title">Tim Borny</h1>
    <p class="hero-lead">
      I build software, design interfaces, and explore visual ways to navigate complex ideas.
    </p>
    <p class="hero-sublead">
      Currently working on tools for thought, local-first apps, and ways to map knowledge across scales.
    </p>
    <div class="hero-actions">
      <a href="#projects" class="btn btn-primary">Projects</a>
      <a href="#writing" class="btn btn-secondary">Writing &amp; Notes</a>
    </div>
  </section>

  <!-- Section 1: Projects -->
  <section id="projects" class="section">
    <div class="section-header">
      <div>
        <h2 class="section-title">Projects</h2>
        <span class="section-subtitle">Things I'm actively building and exploring.</span>
      </div>
    </div>

    <div class="grid-2">
      <ProjectCard
        tag="Knowledge Maps"
        title="Reality Atlas"
        subtitle="Zoomable maps for interconnected ideas"
        description="Exploring how we can browse concepts across deep time and cosmic scales, like navigating a map, rather than flattening everything into lists of search results."
        status="Active Prototype"
        link={`${base}/writing/reality-atlas`}
        linkText="Read working note →"
      />

      <ProjectCard
        tag="Audio &amp; Privacy"
        title="Conversation Memory"
        subtitle="Turning spoken conversations into clear takeaways"
        description="Experiments in capturing high-value discussions (doctor visits, planning sessions, or personal check-ins) and turning them into structured notes. Processed locally on-device without cloud audio retention."
        status="In Progress"
        link={`${base}/writing/audio-is-not-memory`}
        linkText="Read note →"
      />

      <ProjectCard
        tag="Civic / Local"
        title="WeLiveHere"
        subtitle="Making local communities easier to navigate"
        description="An open project to bring together local events, groups, and neighborhood venues that are usually scattered across social media, flyers, and outdated calendars."
        status="In Progress"
      />

      <ProjectCard
        tag="Visual Demos"
        title="Interactive Visualizations"
        subtitle="Explaining tricky concepts with direct manipulation"
        description="Visual explainers and interactive simulations exploring topics in astrophysics, scale, and dynamical systems."
        status="Ongoing"
        link={`${base}/photography`}
        linkText="View photos &amp; visuals →"
      />
    </div>
  </section>

  <hr />

  <!-- Section 2: Writing & Notes -->
  <section id="writing" class="section">
    <div class="section-header">
      <div>
        <h2 class="section-title">Writing &amp; Notes</h2>
        <span class="section-subtitle">Working notes and thoughts on interfaces and projects.</span>
      </div>
      <a href={`${base}/writing`} class="section-link">All notes ({sortedEssays.length}) →</a>
    </div>

    <div class="essays-feed">
      {sortedEssays.map((essay) => {
        const slug = essay.id.replace(/\.md$/, '');
        const formattedDate = new Intl.DateTimeFormat('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        }).format(essay.data.pubDate);

        return (
          <a href={`${base}/writing/${slug}`} class="essay-card card">
            <div class="essay-meta">
              <span class="meta-date">{formattedDate}</span>
              <span class="badge-status">{essay.data.status}</span>
              {essay.data.readTime && <span class="meta-read">{essay.data.readTime} read</span>}
            </div>
            <h3 class="essay-card-title">{essay.data.title}</h3>
            <p class="essay-card-desc">{essay.data.description}</p>
            <span class="essay-cta">Read note →</span>
          </a>
        );
      })}
    </div>
  </section>

  <hr />

  <!-- Section 3: Photography Preview -->
  <section id="photography" class="section">
    <div class="section-header">
      <div>
        <h2 class="section-title">Photography</h2>
        <span class="section-subtitle">Outdoor and landscape photos from trail runs, ski tours, and travel.</span>
      </div>
      <a href={`${base}/photography`} class="section-link">View all photos (60+) →</a>
    </div>

    <PhotoGrid limit={6} />

    <div class="gallery-more-cta">
      <a href={`${base}/photography`} class="btn btn-secondary">Open Full Photography Gallery →</a>
    </div>
  </section>

  <hr />

  <!-- Section 4: About -->
  <section id="about" class="section">
    <div class="section-header">
      <div>
        <h2 class="section-title">About</h2>
        <span class="section-subtitle">A bit of background.</span>
      </div>
    </div>

    <div class="about-content">
      <p class="lead">
        I'm a developer, designer, and generalist. I like digging into messy problems and building tools that make complicated things simpler to understand.
      </p>
      <p>
        Most of my work centers on web systems, interactive visualization, and finding better ways to organize and present information.
      </p>
      <p>
        When I'm away from a screen, I spend as much time as possible outside: trail running, backpacking, skiing, tinkering on guitar, or playing pickleball with friends.
      </p>
    </div>
  </section>

  <hr />

  <!-- Section 5: Connect -->
  <section id="connect" class="section">
    <div class="connect-card card">
      <h2 class="connect-title">Say Hello</h2>
      <p class="connect-desc">
        Always happy to chat about interface design, tools for thought, software projects, or outdoor routes.
      </p>
      <div class="connect-links">
        <a href="https://bsky.app/profile/timborny.bsky.social" target="_blank" rel="noopener noreferrer" class="connect-btn">
          Bluesky
        </a>
        <a href="https://linkedin.com/in/timborny" target="_blank" rel="noopener noreferrer" class="connect-btn">
          LinkedIn
        </a>
        <a href="https://github.com/MintyOrb" target="_blank" rel="noopener noreferrer" class="connect-btn">
          GitHub
        </a>
        <a href={`${base}/rss.xml`} class="connect-btn">
          RSS
        </a>
        <a href="mailto:hello@timborny.com" class="connect-btn primary">
          Email Me →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Styles */
  .hero {
    padding: 2.5rem 0 3rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-title {
    font-size: 2.8rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #ffffff;
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .hero-lead {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--text);
    max-width: 660px;
    margin-bottom: 0.75rem;
  }

  .hero-sublead {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 620px;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius);
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--lantern);
    color: #0d0f12;
    font-weight: 600;
  }

  .btn-primary:hover {
    background: #fbbf24;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
  }

  .btn-secondary {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    border-color: var(--border-light);
    background: var(--surface-hover);
    transform: translateY(-1px);
  }

  /* Section Styles */
  .section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: 1.65rem;
    letter-spacing: -0.015em;
  }

  .section-subtitle {
    font-size: 0.9rem;
    color: var(--text-muted);
    display: block;
    margin-top: 0.2rem;
  }

  .section-link {
    font-size: 0.85rem;
    color: var(--lantern);
    font-weight: 500;
  }

  .section-link:hover {
    text-decoration: underline;
  }

  /* Essays Feed */
  .essays-feed {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .essay-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
  }

  .essay-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .badge-status {
    color: var(--lantern);
    background: var(--lantern-glow);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  .essay-card-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
    transition: color 0.15s ease;
  }

  .essay-card:hover .essay-card-title {
    color: var(--lantern);
  }

  .essay-card-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .essay-cta {
    font-size: 0.82rem;
    color: var(--lantern);
    font-weight: 500;
    margin-top: 0.35rem;
  }

  .gallery-more-cta {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }

  /* About Content */
  .about-content {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  /* Connect Card */
  .connect-card {
    text-align: center;
    padding: 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    background: var(--surface);
    border-color: var(--border);
  }

  .connect-title {
    font-size: 1.5rem;
  }

  .connect-desc {
    max-width: 520px;
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .connect-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .connect-btn {
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    background: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text);
    transition: all 0.15s ease;
  }

  .connect-btn:hover {
    border-color: var(--border-light);
    color: var(--lantern);
    transform: translateY(-1px);
  }

  .connect-btn.primary {
    background: var(--lantern);
    color: #0d0f12;
    border-color: var(--lantern);
    font-weight: 600;
  }

  .connect-btn.primary:hover {
    background: #fbbf24;
    color: #0d0f12;
  }

  @media (max-width: 600px) {
    .hero-title {
      font-size: 2.3rem;
    }
    .hero-lead {
      font-size: 1.1rem;
    }
  }
</style>
