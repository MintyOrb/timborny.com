---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
---

<BaseLayout
  title="Photography — Tim Borny"
  description="Outdoor, landscape, and travel photography by Tim Borny."
>
  <div class="photo-page-container">
    <header class="page-header">
      <h1 class="page-title">Photography</h1>
      <p class="page-desc">
        Photos from trail runs, backpacking trips, backcountry ski lines, and travels around the Pacific Northwest and beyond.
      </p>
    </header>

    <PhotoGrid />
  </div>
</BaseLayout>

<style>
  .photo-page-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: 1080px;
    margin: 0 auto;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    font-size: 2.2rem;
    letter-spacing: -0.02em;
  }

  .page-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 620px;
    margin: 0;
    line-height: 1.6;
  }
</style>
